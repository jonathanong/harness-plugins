{
  "name": "harness-plugins",
  "private": true,
  "description": "Generic agent skills that explain a design or a procedure.",
  "license": "MIT",
  "repository": "github:jonathanong/harness-plugins",
  "type": "module",
  "scripts": {
    "evals": "./scripts/run-evals.sh",
    "evals:check": "./scripts/check-evals.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
